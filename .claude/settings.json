{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run start)",
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit 2>&1 | head -30)",
      "Bash(npx vercel)",
      "Bash(npx vercel --prod)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff HEAD)",
      "Bash(git log --oneline -10)",
      "Bash(git log --oneline -20)",
      "Bash(git add .)",
      "Bash(git add app/*)",
      "Bash(git commit -m *)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/satosota/Downloads/asset-journey && npx tsc --noEmit 2>&1 | head -20"
          }
        ]
      }
    ]
  }
}
